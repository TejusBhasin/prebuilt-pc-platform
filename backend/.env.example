# Postgres connection string (Neon). Use the pooled -pooler host in deployment.
DATABASE_URL=

# Bearer token required for POST/PUT/DELETE. Generate with: openssl rand -base64 32
# Must be at least 32 characters. Never expose this to the frontend.
ADMIN_API_TOKEN=

# Comma-separated origins allowed to call the API. Defaults to http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
